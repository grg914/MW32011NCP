#version 450

// Half-resolution SSGI -> full-resolution scene composite. Output is LINEAR
// scene radiance; HDR10 conversion and DLSS must be separate passes.
// Never read and write the same VkImage in this dispatch.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D uOriginalScene;
layout(set = 0, binding = 1) uniform sampler2D uHalfResSsgi;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D uComposite;

layout(set = 0, binding = 3, std140) uniform CompositeParams {
    vec4 params; // x = intensity (0..2), y = max indirect, z/w unused
} cfg;

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uComposite);
    if (any(greaterThanEqual(xy, sz))) return;
    vec2 uv = (vec2(xy) + 0.5) / vec2(sz);
    vec3 direct = max(textureLod(uOriginalScene, uv, 0.0).rgb, vec3(0.0));
    // Sampler for half-res GI must be linear-filtered. Edge-aware upsampling
    // and temporal reprojection can improve quality in a future pass.
    vec3 indirect = max(textureLod(uHalfResSsgi, uv, 0.0).rgb, vec3(0.0));
    vec3 result = direct + min(indirect, vec3(max(cfg.params.y, 0.0))) *
                          clamp(cfg.params.x, 0.0, 2.0);
    imageStore(uComposite, xy, vec4(result, 1.0));
}
