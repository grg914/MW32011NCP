#version 450

// Depth-guided bilateral upsample of half-resolution SSGI and composition
// into full-resolution LINEAR scene radiance. Must run before DLSS and HDR10
// tone mapping. This is an experimental shader, not yet dispatched by IW5.
// A 4-tap bilateral filter reduces edge halos while bounding GPU cost.
// Source and target must be DISTINCT VkImages.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D uOriginalScene;
layout(set = 0, binding = 1) uniform sampler2D uHalfResSsgi;
layout(set = 0, binding = 2) uniform sampler2D uFullResDepth;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uComposite;

layout(set = 0, binding = 4, std140) uniform CompositeParams {
    vec4 params;
    // x = intensity (0..2)
    // y = maximum indirect radiance
    // z = tolerated non-linear depth difference for cross-edge filtering
    // w = reserved
} cfg;

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uComposite);
    if (any(greaterThanEqual(xy, sz))) return;

    vec2 uv = (vec2(xy) + 0.5) / vec2(sz);
    vec3 direct = max(textureLod(uOriginalScene, uv, 0.0).rgb, vec3(0.0));
    float centerDepth = textureLod(uFullResDepth, uv, 0.0).r;
    if (centerDepth <= 0.00001 || centerDepth >= 0.99999) {
        imageStore(uComposite, xy, vec4(direct, 1.0));
        return;
    }

    ivec2 halfSize = textureSize(uHalfResSsgi, 0);
    ivec2 depthSize = textureSize(uFullResDepth, 0);
    if (any(lessThanEqual(halfSize, ivec2(0))) ||
        any(lessThanEqual(depthSize, ivec2(0)))) {
        imageStore(uComposite, xy, vec4(direct, 1.0));
        return;
    }

    vec2 halfPos = uv * vec2(halfSize) - 0.5;
    ivec2 base = ivec2(floor(halfPos));
    vec2 t = fract(halfPos);
    float depthSigma = max(cfg.params.z, 0.00001);

    vec3 indirect = vec3(0.0);
    float totalWeight = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 cell = clamp(base + ivec2(x, y), ivec2(0), halfSize - 1);
            vec2 halfUV = (vec2(cell) + 0.5) / vec2(halfSize);
            float neighborDepth = textureLod(uFullResDepth, halfUV, 0.0).r;
            if (neighborDepth <= 0.00001 || neighborDepth >= 0.99999)
                continue;

            vec2 bilinear = vec2(x == 0 ? 1.0 - t.x : t.x,
                                 y == 0 ? 1.0 - t.y : t.y);
            float spatialWeight = bilinear.x * bilinear.y;
            float depthWeight = exp(-abs(neighborDepth - centerDepth) / depthSigma);
            float weight = spatialWeight * depthWeight;
            indirect += max(texelFetch(uHalfResSsgi, cell, 0).rgb, vec3(0.0)) * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight > 0.00001)
        indirect /= totalWeight;

    vec3 result = direct + min(indirect, vec3(max(cfg.params.y, 0.0))) *
                          clamp(cfg.params.x, 0.0, 2.0);
    imageStore(uComposite, xy, vec4(result, 1.0));
}
